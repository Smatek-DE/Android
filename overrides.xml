  <project path="rkbin" name="rkbin" remote="rockchip-linux" revision="master" />

  <!-- Remove unnecessary projects -->
  <remove-project name="platform/developers/demos" />
  <remove-project name="platform/developers/samples/android" />
  <remove-project name="platform/frameworks/opt/photoviewer" />
  <remove-project name="platform/frameworks/opt/vcard" />
  <remove-project name="platform/hardware/google/pixel" />
  <remove-project name="platform/hardware/google/pixel-sepolicy" />

  <remove-project name="platform/packages/providers/BookmarkProvider" />
  <remove-project name="platform/packages/providers/PartnerBookmarksProvider" />
  <remove-project name="platform/packages/providers/UserDictionaryProvider" />

  <include name="remove/index.xml" />

  <!-- Eigenen Kernel hinzufügen
  <project name="my-kernel" remote="bab" path="kernel/common" revision="my-branch"/>-->

  <!-- Eigenes Device-Tree Projekt hinzufügen
  <project name="device_brand_model" remote="bab" path="device/brand/model" revision="r-11.0"/>-->

  <project path="." name="Builder" remote="bab" revision="main" />
</manifest>
