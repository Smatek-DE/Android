<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- AOSP Remote -->
  <remote name="aosp"
          fetch="https://android.googlesource.com" />

  <!-- Default Revision für alle Projekte ohne eigenen revision -->
  <default remote="aosp"
           revision="refs/tags/android-11.0.0_r48" />

  <!-- Das AOSP Manifest selbst als Projekt klonen -->
  <project name="platform/manifest"
           path="aosp"
           remote="aosp"
           revision="refs/tags/android-11.0.0_r48" />

  <!-- Rockchip Vendor-Projekte -->
  <include name="default-rockchip.xml" />

  <!-- Deine Overrides -->
  <include name="overrides.xml" />

</manifest>
