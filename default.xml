<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="aosp"
          fetch="https://android.googlesource.com" />

  <remote name="smatek"
          fetch="https://github.com/Smatek-DE/" />

  <default remote="aosp"
           revision="refs/tags/android-11.0.0_r48" />

  <!-- AOSP Manifest Repo laden -->
  <project name="platform/manifest"
           path="aosp"
           remote="aosp"
           revision="refs/tags/android-11.0.0_r48" />

  <!-- Include innerhalb des Repo-Workspaces -->
  <include name="aosp/default.xml" />

  <!-- Rockchip Vendor -->
  <include name="default-rockchip.xml" />

  <!-- Deine Overrides -->
  <include name="overrides.xml" />

</manifest>
